# Aetherion Chat - Example environment variables
# Copy this file to `.env` and fill values as needed.

# Server ports
PORT=3000
# Optional separate WebSocket port (defaults to PORT when empty)
WS_PORT=

# Redis configuration
# You can either use a simple host:port string, a JSON string, or individual variables below.
# Examples:
# REDIS_CONNECTION=redis.example.com:6379
# REDIS_CONNECTION='{"host":"redis.example.com","port":6379,"password":"s3cret","socket":{"tls":true}}'
REDIS_CONNECTION=

# Individual Redis components (used when REDIS_CONNECTION is empty)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Firebase service account JSON (single-line JSON string). Leave empty to disable Firebase features.
# Example (single-line JSON - escape newlines in private_key or use base64 encoding):
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"my-project","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@...gserviceaccount.com"}'
FIREBASE_SERVICE_ACCOUNT=

# Optional: Node environment
NODE_ENV=development
